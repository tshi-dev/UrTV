<?xml version="1.0" encoding="utf-8"?>
<!-- «إنقاذ تلفزيونك» (UrTV Rescue, 4.4): one screen, one button that puts the TV back as it was over its own adb. In the TV's apps list (also on Android TV
     launchers: LEANBACK_LAUNCHER), so it is reached even with no home of ours. INTERNET: the TV's own adb on 127.0.0.1 (no other address is ever opened). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- what our setup turned off is asked of the home through its provider: our key only (both declare it, signature) -->
    <permission android:name="sa.urtv.permission.EXTRAS" android:protectionLevel="signature" />
    <uses-permission android:name="sa.urtv.permission.EXTRAS" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <package android:name="sa.urtv.home" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_rescue"
        android:banner="@mipmap/ic_rescue">
        <activity
            android:name="sa.urtv.home.setup.RescueActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 4.4 (R7): the fallback home, the screen a TV opens when UrTV is gone and the stock home is off. The alias is OFF here, so it never competes with any
             home; the setup turns it on (sa.urtv.home.setup.RescueHome: «pm enable», read back) in the same adb batch that turns the stock home off, and off when the
             stock home is back. FallbackHomeActivity also turns it off by itself when it sees a stock home again. -->
        <!-- the copy of the home's ledger (LedgerKeep): only a sender holding the signature permission (the home) can broadcast to it -->
        <receiver
            android:name="sa.urtv.home.setup.LedgerReceiver"
            android:exported="true"
            android:permission="sa.urtv.permission.EXTRAS">
            <intent-filter>
                <action android:name="sa.urtv.rescue.LEDGER_COPY" />
            </intent-filter>
        </receiver>
        <activity
            android:name="sa.urtv.home.setup.FallbackHomeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <activity-alias
            android:name="sa.urtv.home.setup.RescueHome"
            android:targetActivity="sa.urtv.home.setup.FallbackHomeActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>

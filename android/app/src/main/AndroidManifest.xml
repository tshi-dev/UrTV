<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- only used if the owner allows it for the app: the idle delay row and SaverReceiver's idle -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- the launcher (same signing key) reads the settings for its home-screen card -->
    <permission
        android:name="sa.urtv.screensaver.READ_CONFIG"
        android:protectionLevel="signature" />

    <!-- the launcher adds, finishes and deletes «المهام» through the same provider -->
    <permission
        android:name="sa.urtv.screensaver.WRITE_TASKS"
        android:protectionLevel="signature" />

    <!-- the launcher's «تحكم من الجوال» changes the city and the home cards through the same provider (ConfigProvider.call) -->
    <permission
        android:name="sa.urtv.screensaver.PHONE_SETTINGS"
        android:protectionLevel="signature" />

    <!-- the launcher says what it is playing, for the screen's «يُتلى الآن» card (same signing key) -->
    <!-- the glass look: the home's small blurred backdrop for the settings (signature permission, same key). Declared here too, the same
         as in the home app: this app is installed first, and Android grants a permission only from an app that declared it already -->
    <permission
        android:name="sa.urtv.home.READ_GLASS"
        android:protectionLevel="signature" />
    <uses-permission android:name="sa.urtv.home.READ_GLASS" />
    <uses-permission android:name="sa.urtv.home.READ_NOW_PLAYING" />
    <!-- opens the launcher's «حماية العائلة» screen (signature permission, same key) -->
    <uses-permission android:name="sa.urtv.home.FAMILY_DNS" />

    <!-- opens the launcher's «تحديث تلفزيوني» from settings (signature permission, same key) -->
    <uses-permission android:name="sa.urtv.home.OPEN_UPDATE" />
    <uses-permission android:name="sa.urtv.home.OPEN_PHONE" />
    <uses-permission android:name="sa.urtv.home.OPEN_CLEAN" />

    <!-- opens the launcher's «ترتيب المفضلة» from settings -->
    <queries>
        <package android:name="sa.urtv.home" />
        <!-- 4.3 «تطبيق المباريات»: the TV's apps, to choose the one «شاهد المباراة» opens -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- «اجعل UrTV الشاشة الرئيسية»: who answers the Home key now -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- opening the app shows «تلفزيونك»: four windows (the markets, the matches, the games, the settings) -->
        <activity
            android:name=".YourTvHubActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- the settings: the hub's fourth window, and where the remote's Settings key, the control center and the home's settings button go -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true" />

        <!-- «الألعاب»: the hub's third window, the games list, and «الأسرع» (the live quiz: the TV side; its game-only server is not the remote's pairing) -->
        <activity
            android:name=".QuizGamesActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".QuizActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode" />
        <activity
            android:name=".LetterHiveActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode" />
        <activity
            android:name=".Word5Activity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode" />

        <!-- «صور شاشة التوقف»: the photo packs, opened from the settings only -->
        <activity android:name=".PhotoPacksActivity" android:exported="false" />
        <activity android:name=".AppearanceActivity" android:exported="false" />
        <!-- step 41: over the home app's own replace, so the app used before does not come to the front; only the home app opens it (signature) -->
        <activity
            android:name=".UpdateCover"
            android:exported="true"
            android:permission="sa.urtv.screensaver.PHONE_SETTINGS"
            android:launchMode="singleTask"
            android:taskAffinity="sa.urtv.screensaver.cover"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- full-screen preview; any remote key closes it -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <service
            android:name=".ScreenDream"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.service.dream" android:resource="@xml/dream" />
        </service>

        <service
            android:name=".UpdateJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- settings from ADB (agents, optimize/saver.sh); DUMP = only the shell can send it -->
        <receiver
            android:name=".SaverReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="sa.urtv.screensaver.GET" />
                <action android:name="sa.urtv.screensaver.SET" />
                <action android:name="sa.urtv.screensaver.CITIES" />
                <action android:name="sa.urtv.screensaver.UPDATE" />
                <action android:name="sa.urtv.screensaver.TASKS" />
                <action android:name="sa.urtv.screensaver.PHOTOS" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".ConfigProvider"
            android:authorities="sa.urtv.screensaver.config"
            android:exported="true"
            android:readPermission="sa.urtv.screensaver.READ_CONFIG"
            android:writePermission="sa.urtv.screensaver.WRITE_TASKS">
            <!-- the shell hands over a photo here (`content write`, optimize/photos.sh); DUMP as for SaverReceiver -->
            <path-permission
                android:path="/own-in"
                android:readPermission="android.permission.DUMP"
                android:writePermission="android.permission.DUMP" />
        </provider>
    </application>
</manifest>

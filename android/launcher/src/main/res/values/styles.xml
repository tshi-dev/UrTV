<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Home" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>

    <!-- the «تلاوة وأذان» screens: the glass look's colours as theme attributes (attrs.xml); App is the glass look in the dark, the
         default; Ui.theme picks the theme of «المظهر» (الشكل and الإضاءة) before a screen is drawn -->
    <style name="App" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">?attr/gBg</item>
        <item name="android:colorBackground">?attr/gBg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:colorAccent">?attr/gAccent</item>
        <item name="gBg">#17181B</item>
        <item name="gBgFade">#E617181B</item>
        <item name="gText">#FFFFFF</item>
        <item name="gSub">#DADCE0</item>
        <item name="gAccent">#FFFFFF</item>
        <item name="gWarn">#FFC2B3</item>
        <item name="gPanel">#6B14161A</item>
        <item name="gLine">#24FFFFFF</item>
        <item name="gDialogSolid">#18191C</item>
        <item name="gFocus">#F2FFFFFF</item>
        <item name="gOnFocus">#14161A</item>
        <item name="gOnFocusSub">#3A3E46</item>
    </style>

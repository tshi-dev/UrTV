<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher settings. Edit, push, and GitHub Actions rebuilds urtv-home.apk; then run optimize/install.sh.
  Package names on your TV: optimize/venv/bin/python -I optimize/tv.py 'pm list packages'
-->
<resources>
    <!-- Default dock apps, left to right (apps not installed are skipped). On the TV, long-press OK on any
         app to add it, remove it or move it, or from ADB with optimize/dock.sh; that choice is saved on the TV
         and replaces this list. -->
    <string-array name="dock_apps">
        <item>com.google.android.youtube.tv</item>
        <item>com.netflix.ninja</item>
        <item>com.netflix.mediaclient</item>   <!-- Netflix on some TCL / Android TV builds -->
        <item>net.mbc.shahidTV</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>com.disney.disneyplus</item>
        <item>com.apple.atve.androidtv.appletv</item>
    </string-array>

    <!-- Never shown as tiles: system helpers, and the Live TV app (it's in the Inputs menu). -->
    <string-array name="hidden_apps">
        <item>com.tcl.tv</item>
        <item>com.tcl.suspension</item>
        <item>com.tcl.t_solo</item>
        <item>com.tcl.dashboard</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, listed last in the Inputs menu. Empty to leave it out.
         Common ones: com.tcl.tv (TCL), com.mediatek.wwtv.tvcenter (Xiaomi, many MediaTek sets),
         com.google.android.tv (Google Live Channels), com.sony.dtv.tvx (Sony). -->
    <string name="live_tv_package" translatable="false">com.tcl.tv</string>

    <!-- The manufacturer's own source picker, used if switching to an input directly fails. -->
    <string name="input_picker_package" translatable="false">com.tcl.suspension</string>

    <!-- Tiles per row in the grid. -->
    <integer name="columns">5</integer>

    <!-- The «تلاوة» button in the top bar: the Quran recitations and the radio, inside the home app.
         Set it to false to leave the button out. -->
    <bool name="show_listening">true</bool>

    <!-- Where the TV is, for the adhan times (Umm al-Qura). The city picked in the screensaver wins;
         these are the fallback when the screensaver is not installed. -->
    <string name="latitude" translatable="false">24.6877</string>
    <string name="longitude" translatable="false">46.7219</string>
    <string name="timezone" translatable="false">Asia/Riyadh</string>

    <!-- When an update is found it is downloaded here; the version is read from this file. -->
    <string name="update_base" translatable="false">https://github.com/tshi-dev/UrTV/releases/download/apk-latest/</string>
</resources>

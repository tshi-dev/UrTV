<?xml version="1.0" encoding="utf-8"?>
<!-- a word of the «تلاوة وأذان» screens: ?attr/gAccent at rest, the focus ink (?attr/gOnFocus) on a focused or selected row's solid fill -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="?attr/gOnFocus" />
    <item android:state_selected="true" android:color="?attr/gOnFocus" />
    <item android:color="?attr/gAccent" />
</selector>

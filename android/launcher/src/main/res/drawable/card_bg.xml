<?xml version="1.0" encoding="utf-8"?>
<!-- a surah's card: the glass panel at rest; selected, nothing, so the grid's solid focus fill (focus_selector) shows under its focus ink -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:drawable="@android:color/transparent" />
    <item>
        <shape android:shape="rectangle"><solid android:color="?attr/gPanel" /><stroke android:width="1dp" android:color="?attr/gLine" /><corners android:radius="14dp" /></shape>
    </item>
</selector>

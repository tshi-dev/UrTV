        <!-- «مؤقت النوم»: the alarm at the end of the timer (ours only); the screen goes off through «إضافات تلفزيونك» when it is on (Extras.sleepNow) -->
        <receiver android:name=".SleepReceiver" android:exported="false" />
        <!-- 4.3.3: no accessibility service in the home any more (Play Protect blocked the home for them, «بيانات حساسة»). They are in the optional add-on
             «إضافات تلفزيونك» (sa.urtv.extras, ExtrasA11yService); the home asks it through its provider (Extras) and answers it here (ExtrasBridge), both
             guarded by the signature permission sa.urtv.permission.EXTRAS. -->
        <provider
            android:name=".ExtrasBridge"
            android:authorities="sa.urtv.home.extras"
            android:exported="true"
            android:permission="sa.urtv.permission.EXTRAS" />
        <!-- 4.4 beta 3, the paired route's installs: one APK at a time under a random token, read only by our add-on (the same signature permission), deleted right after -->
        <provider
            android:name=".setup.PairFiles"
            android:authorities="sa.urtv.home.pairfiles"
            android:exported="true"
            android:permission="sa.urtv.permission.EXTRAS" />
        <!-- the offer: install «إضافات تلفزيونك» or turn its service on (opened only when a feature that needs it was asked for) -->
        <activity android:name=".ExtrasActivity" android:exported="true" android:permission="sa.urtv.home.OPEN_EXTRAS" android:screenOrientation="landscape" android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- the «تلاوة» screens: the Quran recitations and the radio, inside the home screen (the «تلاوة» pill).
             Not exported and with no launcher category on purpose: it must not show up among the apps. -->

        <activity
            android:name=".tilawah.MainActivity"

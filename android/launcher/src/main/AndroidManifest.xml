<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen adapted from github.com/mihirgupta0900/tv-home (MIT). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />   <!-- hosted wallpapers, the optional card -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- «أكمل المشاهدة»: the TV's Watch Next list; asked once in WatchNextActivity, nothing read without it -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 11 only reveals the Wi-Fi name to apps holding location; granted over ADB at install. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- the optional home-screen card reads the screensaver's settings (signature permission, same key) -->
    <uses-permission android:name="sa.urtv.screensaver.READ_CONFIG" />
    <!-- «المهام»: add, finish and delete tasks kept by the screensaver (signature permission, same key) -->
    <uses-permission android:name="sa.urtv.screensaver.WRITE_TASKS" />
    <!-- the «تلاوة» screens: the Quran and the radio, living in this app -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- «إعداد تلفزيوني»: SetupService holds the setup run as a foreground service; from targetSdk 34 every foreground service names its type, and
         a TV setting itself up over its own adb fits no other type than specialUse (see the property on SetupService) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- the adhan alarm, put back after a reboot or a clock change -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- the adhan at its minute (an alarm clock for the prayer times): from targetSdk 33, Android 14 no longer gives SCHEDULE_EXACT_ALARM to a new
         install, so a TV set up from Downloader would hear the adhan minutes late until the setup's appops ran. USE_EXACT_ALARM (Android 13+, a
         normal permission) keeps it exact as it was on 30; Android 12 still reads SCHEDULE_EXACT_ALARM above. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- the adhan sets the TV's volume to its own level and puts it back afterwards -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- «حماية العائلة (DNS)»: Private DNS (Settings.Global). Granted only over ADB by `optimize/dock.sh familydns grant`;
         without it the feature says so and does nothing. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- «تحكم من الجوال»: changes the city and the home cards through the screensaver's provider (signature permission, same key); step 41: it
         also opens and closes the screensaver's UpdateCover over our own replace -->
    <uses-permission android:name="sa.urtv.screensaver.PHONE_SETTINGS" />
    <!-- «تحديث تلفزيونك» from the phone: hands the APKs it downloaded to Android's own install screen, where the owner confirms -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- «حذف التطبيق» in the app menu: hands the app to Android's own uninstall, which asks the person to confirm (a normal permission) -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- the screensaver (same signing key) asks what is playing, for its «يُتلى الآن» card -->
    <permission
        android:name="sa.urtv.home.READ_NOW_PLAYING"
        android:protectionLevel="signature" />

    <!-- opens «حماية العائلة»: the screensaver app (same signing key) holds it, so nothing else can start that screen -->
    <permission
        android:name="sa.urtv.home.FAMILY_DNS"
        android:protectionLevel="signature" />

    <!-- the glass look's small blurred backdrop of the home's photo: only our two apps (same signing key) may read it (GlassProvider) -->
    <permission
        android:name="sa.urtv.home.READ_GLASS"
        android:protectionLevel="signature" />

    <!-- «تحديث تلفزيوني»: only our two apps (same signing key) may open the update screen -->
    <permission
        android:name="sa.urtv.home.OPEN_UPDATE"
        android:protectionLevel="signature" />

    <!-- «تحكم من الجوال»: only our two apps (same signing key) may open the pairing screen from outside (the screensaver's settings) -->
    <permission
        android:name="sa.urtv.home.OPEN_PHONE"
        android:protectionLevel="signature" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <!-- «صفحته في المتجر» only when the Play Store is on the TV -->
        <package android:name="com.android.vending" />
        <!-- the Settings key's SystemUI handler: whether it resolves (SettingsKey.NOTIFICATION_PANEL_ACTION, a Haier MatrixTV has none) -->
        <intent>
            <action android:name="android.app.action.TOGGLE_NOTIFICATION_HANDLER_PANEL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <!-- apps with only an ordinary launcher activity (OEM stores and settings, phone apps) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- other home screens, left out of the grid -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- «المهام»: is there a speech recognizer on this TV? -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- the remote's Settings key outside our home (TypeService, SettingsKey.TV_SETTINGS_ACTIONS): on Android 11+ the TV's settings
             screen must be visible, or resolveActivity finds nothing and the family lock cannot name its package -->
        <!-- «البلوتوث» in «مركز التحكم» (ControlText.BLUETOOTH_ACTIONS): the tile is there only when one of these resolves -->
        <intent>
            <action android:name="android.settings.BLUETOOTH_SETTINGS" />
        </intent>
        <intent>
            <action android:name="com.google.android.intent.action.CONNECT_INPUT" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <!-- «شاهد على ثمانية» on a game's card: Thmanyah's apps (the TV build first), so the page can tell whether one is installed -->
        <package android:name="com.thmanyah.shasha.tv" />
        <package android:name="com.thmanyah.shasha" />
        <!-- «المصادر»: the TVs' live TV apps and source pickers (TvVendor.LIVE_TV, TvVendor.PICKERS), found on the TV when the menu opens -->
        <package android:name="com.tcl.tv" />
        <package android:name="com.tcl.suspension" />
        <package android:name="com.cultraview.livetv" />
        <package android:name="com.cultraview.setting" />
        <package android:name="com.mediatek.wwtv.tvcenter" />
        <package android:name="com.mstar.tv.tvplayer.ui" />
        <package android:name="com.sony.dtv.tvx" />
        <package android:name="org.droidtv.playtv" />
        <package android:name="com.google.android.tv" />
        <package android:name="sa.urtv.screensaver" />
        <!-- «انعكاس الشاشة» in «مركز التحكم»: the TVs' mirroring apps (ControlText.MIRROR_APPS), seen even when one has no launcher entry -->
        <package android:name="com.tcl.miracast" />
        <package android:name="com.softwinner.miracastReceiver" />
        <package android:name="com.homwee.mmp.screenshare" />
        <package android:name="com.xiaomi.mitv.smartshare" />
        <package android:name="com.mediatek.wfd" />
        <!-- the stock Google homes (Dock.GOOGLE_HOMES): so getPackageInfo sees a disabled one on Android 11+ -->
        <package android:name="com.google.android.apps.tv.launcherx" />
        <package android:name="com.google.android.tvlauncher" />
        <package android:name="com.google.android.leanbacklauncher" />
    </queries>

    <!-- 4.3: lets our other app (UrTV Player, signed with another key) read «اللغة», ar or en, and nothing else (LangProvider). Normal level:
         the player asks for it in its manifest; it gives no other access -->
    <permission
        android:name="sa.urtv.permission.READ_LANG"
        android:protectionLevel="normal" />

    <application
        android:name=".HomeApp"
        android:label="تلفزيونك"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Home">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- «تلفزيونك»: a tile for the TV's own home screen (the apps row of Google TV), for the one in four setups that keeps the stock home
             (setupwraith / launcherx): without it UrTV's home could not be opened at all. It opens the same MainActivity by component, with no
             HOME category, so it never changes which home is the default (the HOME entry above is the only one) and cannot loop with the HOME
             intent; MainActivity says Back leaves it when it is not the default home. Our own «كل التطبيقات» skips our package (Dock.scan). -->
        <activity-alias
            android:name=".HomeTile"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="تلفزيونك"
            android:icon="@mipmap/ic_launcher"
            android:banner="@drawable/banner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- «إعداد تلفزيوني»: the setup done by the TV itself over its own local adb, no computer. A launcher entry of its own (apps row), so it is there
             right after the APK is installed with the TV's Downloader app, before this app is Home. Nothing outside the app can start the run: the
             buttons are on this screen. -->
        <activity
            android:name=".setup.SetupActivity"
            android:exported="true"
            android:label="إعداد تلفزيوني"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- a setup run holds the process while it goes (it outlives the setup screen); not exported, it stops itself at the end -->
        <service android:name=".setup.SetupService" android:exported="false" android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="The TV sets itself up over its own local adb (settings, the home switch); the run outlives the setup screen and stops itself at the end." />
        </service>
        <!-- the in-app safety switch of the home switch: puts the stock home back after 5 minutes unless it was confirmed (ours only) -->
        <receiver android:name=".setup.SetupRevertReceiver" android:exported="false" />
        <!-- the TV started again in the middle of a home switch: the safety switch comes back and the stock home is put back (only the system sends this) -->
        <receiver
            android:name=".setup.SetupBootReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- «ترتيب المفضلة»: the favourites as a list; also opened from the screensaver's settings -->
        <activity
            android:name=".DockActivity"
            android:exported="true"
            android:label="ترتيب المفضلة"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- «المباريات»: the page of the games (docs/PROPOSALS-NOV2.md §1), from the football home and from the screensaver's settings
             («المزيد ← مباريات اليوم»); exported only for that, as DockActivity -->
        <activity
            android:name=".MatchesActivity"
            android:exported="true"
            android:label="المباريات"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- «أكمل المشاهدة»: the one question for the TV's Watch Next list; opened from the screensaver's settings row, behind its PIN like DockActivity -->
        <activity
            android:name=".WatchNextActivity"
            android:exported="true"
            android:label="أكمل المشاهدة"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- «أسماء المصادر»: a name for each TV input (HDMI 1 -> PS5), opened from the screensaver's settings; asks for the PIN itself like DockActivity -->
        <activity
            android:name=".InputNamesActivity"
            android:exported="true"
            android:label="أسماء المصادر"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- «حماية العائلة (DNS)»: Private DNS to AdGuard Family, opened from the screensaver's settings -->
        <activity
            android:name=".FamilyDnsActivity"
            android:exported="true"
            android:permission="sa.urtv.home.FAMILY_DNS"
            android:label="حماية العائلة"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- «تحكم من الجوال»: the owner's switch and the pairing screen. Nothing listens until «تشغيل» is pressed there. Exported only so the
             screensaver's settings can open it, behind a signature permission (same key) as UpdateActivity: no other app can. -->
        <activity
            android:name=".PhoneActivity"
            android:exported="true"
            android:permission="sa.urtv.home.OPEN_PHONE"
            android:label="تحكم من الجوال"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- «تحديث تلفزيوني»: the version, the check and the update. Exported only so the screensaver's settings can open it, behind a signature
             permission (same key): no other app can. -->
        <activity
            android:name=".UpdateActivity"
            android:exported="true"
            android:permission="sa.urtv.home.OPEN_UPDATE"
            android:label="تحديث تلفزيوني"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- «أرسل تقرير» of the screensaver's settings: a few lines (the versions, Android, WebView) and a QR code to docs/share; nothing personal, nothing sent from here -->
        <!-- 4.3 #53: a paired phone's short message, over what plays (see-through), 20 s; not exported: only the phone code starts it -->
        <activity
            android:name=".MessageActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity="sa.urtv.home.message"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />
        <!-- 4.3 «تطبيقات مقترحة», opened from the screensaver's settings: each app from its own place, Android's install screen asks the owner -->
        <activity
            android:name=".SuggestedAppsActivity"
            android:exported="true"
            android:label="تطبيقات مقترحة"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <activity
            android:name=".ReportActivity"
            android:exported="true"
            android:label="أرسل تقرير"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- the installer's answer for «تحديث تلفزيونك» (only reached through the app's own PendingIntent) -->
        <receiver
            android:name=".phone.PhoneInstallReceiver"
            android:exported="false" />

        <!-- «الرقابة الأبوية»: the PIN, the locks and kids mode; it asks for the PIN itself once one is set -->
        <activity
            android:name=".ParentalActivity"
            android:exported="true"
            android:label="الرقابة الأبوية"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- «المهام»: the tasks kept by the screensaver app, with a mic (speech recognizer) -->
        <activity
            android:name=".TasksActivity"
            android:exported="true"
            android:windowSoftInputMode="stateHidden"
            android:label="المهام"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- one task's reminder page, opened from «ذكّرني» in «المهام» -->
        <activity
            android:name=".TaskReminderActivity"
            android:exported="false"
            android:label="مهمة"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- «الأسواق»: the markets page (the home's stocks card, the settings); «محفظتي» on it stays in this app's private prefs -->
        <activity
            android:name=".MarketsActivity"
            android:exported="true"
            android:label="الأسواق"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- favourites row from ADB (agents, optimize/dock.sh); DUMP = only the shell can send it -->
        <receiver
            android:name=".DockReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="sa.urtv.home.GET_DOCK" />
                <action android:name="sa.urtv.home.LIST_APPS" />
                <action android:name="sa.urtv.home.SET_DOCK" />
                <action android:name="sa.urtv.home.RESET_DOCK" />
                <action android:name="sa.urtv.home.HIDDEN" />
                <action android:name="sa.urtv.home.HIDE" />
                <action android:name="sa.urtv.home.SHOW" />
                <action android:name="sa.urtv.home.FAMILY_DNS" />
                <action android:name="sa.urtv.home.BACK_SAVER" />
                <action android:name="sa.urtv.home.PHONE_MESSAGE" />
                <action android:name="sa.urtv.home.PIN_SET" />
                <action android:name="sa.urtv.home.PIN_LOCK" />
                <action android:name="sa.urtv.home.PIN_UNLOCK" />
                <action android:name="sa.urtv.home.PIN_STATUS" />
                <action android:name="sa.urtv.home.PIN_OFF" />
                <action android:name="sa.urtv.home.PIN_RESET" />
            </intent-filter>
        </receiver>

        <!-- «مؤقت النوم»: the alarm at the end of the timer (ours only), and the accessibility service that turns the
             screen off then. It listens to nothing: see SleepService. The person (or optimize/dock.sh sleep-setup) turns it on. -->
        <receiver android:name=".SleepReceiver" android:exported="false" />
        <service
            android:name=".SleepService"
            android:exported="true"
            android:label="@string/sleep_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/sleep_service" />
        </service>

        <!-- The phone remote's typing into other apps: a second accessibility service, on only when the owner turns it on (or
             optimize/dock.sh type-setup). It reads no event (it only asks Android for window changes, to know which app is in front) and looks at the screen only when a phone sends text: see TypeService.
             It also answers the remote's Settings key while another app is in front (SettingsKey): no other key is kept or logged. -->
        <service
            android:name=".TypeService"
            android:exported="true"
            android:label="@string/type_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/type_service" />
        </service>

        <!-- the «تلاوة» screens: the Quran recitations and the radio, inside the home screen (the «تلاوة» pill).
             Not exported and with no launcher category on purpose: it must not show up among the apps. -->

        <activity
            android:name=".tilawah.MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:theme="@style/App"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density" />

        <activity
            android:name=".tilawah.SurahActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/App"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density" />

        <activity
            android:name=".tilawah.PlayerActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:theme="@style/App"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density" />

        <activity
            android:name=".tilawah.AdhanActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/App"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density" />

        <service
            android:name=".tilawah.MusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- playback from ADB (agents, optimize/music.sh); DUMP = only the shell can send it -->
        <receiver
            android:name=".tilawah.MusicReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="sa.urtv.home.GET_PLAYER" />
                <action android:name="sa.urtv.home.PLAY_SURAH" />
                <action android:name="sa.urtv.home.PLAY_RADIO" />
                <action android:name="sa.urtv.home.PAUSE" />
                <action android:name="sa.urtv.home.RESUME" />
                <action android:name="sa.urtv.home.TOGGLE" />
                <action android:name="sa.urtv.home.NEXT" />
                <action android:name="sa.urtv.home.PREV" />
                <action android:name="sa.urtv.home.STOP" />
                <action android:name="sa.urtv.home.SLEEP" />
                <action android:name="sa.urtv.home.SEEK_BY" />
                <action android:name="sa.urtv.home.ADHAN" />
                <action android:name="sa.urtv.home.ADHAN_VOLUME" />
                <action android:name="sa.urtv.home.ADHAN_RESCHEDULE" />
                <action android:name="sa.urtv.home.ADHAN_ON" />
                <action android:name="sa.urtv.home.ADHAN_OFF" />
                <action android:name="sa.urtv.home.VOICE" />
                <action android:name="sa.urtv.home.FAJR_VOICE" />
                <action android:name="sa.urtv.home.ADHAN_SHORT" />
                <action android:name="sa.urtv.home.ADHAN_TAKBIR" />
                <action android:name="sa.urtv.home.ADHAN_STOPKEY" />
                <action android:name="sa.urtv.home.ADHAN_SAVERONLY" />
                <action android:name="sa.urtv.home.ADHAN_NOTICE" />
                <action android:name="sa.urtv.home.ADHAN_SAVERAT" />
                <action android:name="sa.urtv.home.STOP_ADHAN" />
                <action android:name="sa.urtv.home.ADHAN_OWN" />
            </intent-filter>
        </receiver>

        <!-- «أذان من ملفي»: the shell hands over the person's own adhan recording here (`content write`, optimize/music.sh
             adhan add); DUMP = only the shell. It only writes; nothing can be read back. -->
        <!-- what is playing (one row while a surah or a station plays), read by the screensaver's card; same key only -->
        <provider
            android:name=".tilawah.NowPlayingProvider"
            android:authorities="sa.urtv.home.nowplaying"
            android:exported="true"
            android:readPermission="sa.urtv.home.READ_NOW_PLAYING" />

        <!-- 4.3 «اللغة» for UrTV Player (another key): content://sa.urtv.home.lang/lang, one row {lang: ar|en}, read only (LangProvider) -->
        <provider
            android:name=".LangProvider"
            android:authorities="sa.urtv.home.lang"
            android:exported="true"
            android:permission="sa.urtv.permission.READ_LANG" />

        <!-- the glass backdrop for the screensaver app's settings: read only, signature permission -->
        <provider
            android:name=".GlassProvider"
            android:authorities="sa.urtv.home.glass"
            android:exported="true"
            android:permission="sa.urtv.home.READ_GLASS" />

        <provider
            android:name=".tilawah.OwnAdhanProvider"
            android:authorities="sa.urtv.home.adhan"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- the adhan: at the prayer time (the alarm names this receiver itself, action ADHAN_ALARM; «sa.urtv.home.ADHAN» is the shell's
             «adhan now» and belongs to MusicReceiver alone), and again after a reboot or a clock change; DUMP = only the shell can send it -->
        <receiver
            android:name=".tilawah.AdhanReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- «المهام» with a time: the alarm of the next reminder (it names this receiver itself, action REMINDER_ALARM), put back after a reboot, a clock
             change or an update (the same auto-start a TCL needs for the adhan's alarms: optimize/autostart.sh), and when the tasks change (the shell's
             REMINDER_RESCHEDULE); DUMP = only the shell and the system can send these -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="sa.urtv.home.REMINDER_RESCHEDULE" />
            </intent-filter>
        </receiver>

        <!-- our accessibility services after an update of this app or a boot: listed but not bound, or the switch off, is healed (A11yHeal); DUMP = only the system sends these -->
        <receiver
            android:name=".A11yHeal"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- the sleep timer does not survive a restart: the saved end is forgotten at boot -->
        <receiver
            android:name=".SleepBootReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

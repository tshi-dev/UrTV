<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen adapted from github.com/mihirgupta0900/tv-home (MIT). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />   <!-- hosted wallpapers, the optional card -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 11 only reveals the Wi-Fi name to apps holding location; granted over ADB at install. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- the optional home-screen card reads the screensaver's settings (signature permission, same key) -->
    <uses-permission android:name="sa.urtv.screensaver.READ_CONFIG" />
    <!-- «المهام»: add, finish and delete tasks kept by the screensaver (signature permission, same key) -->
    <uses-permission android:name="sa.urtv.screensaver.WRITE_TASKS" />
    <!-- the «تلاوة» screens: the Quran and the radio, living in this app -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- the adhan alarm, put back after a reboot or a clock change -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- the adhan sets the TV's volume to its own level and puts it back afterwards -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- the self-update: installs the APK it downloads (optimize/install.sh allows the appop over ADB) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- the screensaver (same signing key) asks what is playing, for its «يُتلى الآن» card -->
    <permission
        android:name="sa.urtv.home.READ_NOW_PLAYING"
        android:protectionLevel="signature" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <!-- apps with only an ordinary launcher activity (OEM stores and settings, phone apps) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- other home screens, left out of the grid -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- «المهام»: is there a speech recognizer on this TV? -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <package android:name="com.tcl.tv" />
        <package android:name="com.tcl.suspension" />
        <package android:name="sa.urtv.screensaver" />
        <!-- the stock Google homes (Dock.GOOGLE_HOMES): so getPackageInfo sees a disabled one on Android 11+ -->
        <package android:name="com.google.android.apps.tv.launcherx" />
        <package android:name="com.google.android.tvlauncher" />
        <package android:name="com.google.android.leanbacklauncher" />
    </queries>

    <application
        android:label="تلفزيونك"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Home">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- «ترتيب المفضلة»: the favourites as a list; also opened from the screensaver's settings -->
        <activity
            android:name=".DockActivity"
            android:exported="true"
            android:label="ترتيب المفضلة"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- «المهام»: the tasks kept by the screensaver app, with a mic (speech recognizer) -->
        <activity
            android:name=".TasksActivity"
            android:exported="true"
            android:label="المهام"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- favourites row from ADB (agents, optimize/dock.sh); DUMP = only the shell can send it -->
        <receiver
            android:name=".DockReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="sa.urtv.home.GET_DOCK" />
                <action android:name="sa.urtv.home.LIST_APPS" />
                <action android:name="sa.urtv.home.SET_DOCK" />
                <action android:name="sa.urtv.home.RESET_DOCK" />
                <action android:name="sa.urtv.home.HIDDEN" />
                <action android:name="sa.urtv.home.HIDE" />
                <action android:name="sa.urtv.home.SHOW" />
            </intent-filter>
        </receiver>

        <!-- «مؤقت النوم»: the alarm at the end of the timer (ours only), and the accessibility service that turns the
             screen off then. It listens to nothing: see SleepService. The person (or optimize/dock.sh sleep-setup) turns it on. -->
        <receiver android:name=".SleepReceiver" android:exported="false" />
        <service
            android:name=".SleepService"
            android:exported="true"
            android:label="@string/sleep_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/sleep_service" />
        </service>

        <!-- the «تلاوة» screens: the Quran recitations and the radio, inside the home screen (the «تلاوة» pill).
             Not exported and with no launcher category on purpose: it must not show up among the apps. -->

        <activity
            android:name=".tilawah.MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:theme="@style/App"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density" />

        <activity
            android:name=".tilawah.SurahActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/App"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density" />

        <activity
            android:name=".tilawah.PlayerActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:theme="@style/App"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density" />

        <activity
            android:name=".tilawah.AdhanActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/App"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density" />

        <service
            android:name=".tilawah.MusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- playback from ADB (agents, optimize/music.sh); DUMP = only the shell can send it -->
        <receiver
            android:name=".tilawah.MusicReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="sa.urtv.home.GET_PLAYER" />
                <action android:name="sa.urtv.home.PLAY_SURAH" />
                <action android:name="sa.urtv.home.PLAY_RADIO" />
                <action android:name="sa.urtv.home.PAUSE" />
                <action android:name="sa.urtv.home.RESUME" />
                <action android:name="sa.urtv.home.TOGGLE" />
                <action android:name="sa.urtv.home.NEXT" />
                <action android:name="sa.urtv.home.PREV" />
                <action android:name="sa.urtv.home.STOP" />
                <action android:name="sa.urtv.home.SLEEP" />
                <action android:name="sa.urtv.home.SEEK_BY" />
                <action android:name="sa.urtv.home.ADHAN" />
                <action android:name="sa.urtv.home.ADHAN_VOLUME" />
                <action android:name="sa.urtv.home.ADHAN_RESCHEDULE" />
                <action android:name="sa.urtv.home.ADHAN_ON" />
                <action android:name="sa.urtv.home.ADHAN_OFF" />
                <action android:name="sa.urtv.home.VOICE" />
                <action android:name="sa.urtv.home.ADHAN_OWN" />
            </intent-filter>
        </receiver>

        <!-- «أذان من ملفي»: the shell hands over the person's own adhan recording here (`content write`, optimize/music.sh
             adhan add); DUMP = only the shell. It only writes; nothing can be read back. -->
        <!-- what is playing (one row while a surah or a station plays), read by the screensaver's card; same key only -->
        <provider
            android:name=".tilawah.NowPlayingProvider"
            android:authorities="sa.urtv.home.nowplaying"
            android:exported="true"
            android:readPermission="sa.urtv.home.READ_NOW_PLAYING" />

        <provider
            android:name=".tilawah.OwnAdhanProvider"
            android:authorities="sa.urtv.home.adhan"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- the adhan: at the prayer time (the alarm names this receiver itself, action ADHAN_ALARM; «sa.urtv.home.ADHAN» is the shell's
             «adhan now» and belongs to MusicReceiver alone), and again after a reboot or a clock change; DUMP = only the shell can send it -->
        <receiver
            android:name=".tilawah.AdhanReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- the installer's answer to the self-update (only reached through the app's own PendingIntent) -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />
    </application>
</manifest>
